{
  "name": "verflecht",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "data:build": "python build_data_pipeline.py",
    "data:check": "python build_data_pipeline.py --check",
    "data:import:lobbywatch": "python import_lobbywatch.py",
    "data:verify:lobbywatch": "python verify_lobbywatch.py",
    "data:import:parliament": "python import_parliament.py --refresh",
    "data:review:lobbywatch": "python review_lobbywatch.py",
    "test:pipeline": "python -m unittest discover -s tests/pipeline -v",
    "predev": "pnpm data:build",
    "prebuild": "pnpm data:build",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "^15.5.24",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^24.2.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.33.0",
    "eslint-config-next": "^15.5.24",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  }
}
